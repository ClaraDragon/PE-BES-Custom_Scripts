  # ---------------------------------------------------------------------------
  # Dibujar gráfico radar de estadísticas de concurso
  # ---------------------------------------------------------------------------
  def drawContestStatsRadar(overlay)
    # Posiciones configurables - USAR ENTEROS
    base_center_x = 104  # Centro del pentágono X (sin zoom)
    base_center_y = 204 + 3  # Centro del pentágono Y (sin zoom)
    base_radius = 50     # Radio del pentágono (sin zoom)
    
    # Factor de zoom
    zoom_factor = 2
    
    # Coordenadas ajustadas para el zoom
    center_x = base_center_x / zoom_factor
    center_y = base_center_y / zoom_factor
    radius = base_radius / zoom_factor
    
    # Estadísticas de concurso (normalizadas de 0-255 a 0-30)
    contest_stats = [
      @pokemon.cute.to_i,
      @pokemon.tough.to_i,
      @pokemon.beauty.to_i,
      @pokemon.cool.to_i,
      @pokemon.smart.to_i,
    ]
    
    # Crear sprite del pentágono si no existe
    if !@sprites["pentagon_contest"].bitmap
      #@sprites["pentagon_contest"] = Sprite.new(@viewport)
      @sprites["pentagon_contest"].bitmap = Bitmap.new(Graphics.width, Graphics.height)
      @sprites["pentagon_contest"].zoom_x = zoom_factor
      @sprites["pentagon_contest"].zoom_y = zoom_factor
      @sprites["pentagon_contest"].z = @sprites["bg"].z# + 1
    end
    
    # Limpiar bitmap anterior
    if @sprites["pentagon_contest"].bitmap
      @sprites["pentagon_contest"].bitmap.clear
      
      # Dibujar pentágono relleno
      draw_filled_pentagon_with_values(
        @sprites["pentagon_contest"].bitmap,
        center_x, center_y+2, ((radius + 1) & ~1) - 2, contest_stats
      )
    end
    
    # ... (el resto del código de texto permanece igual)
    # Colores para texto
    base_color = Color.new(246, 198, 6)
    shadow_color = Color.new(74, 97, 103)
    stat_color = Color.new(248, 248, 248)
    stat_shadow = Color.new(74, 112, 175)
    
    # Texto de título
    textpos = []
    
    # Posiciones para nombres de estadísticas
    angles = [90, 18, -54, -126, 162]
    stat_names = ["Dulzura", "Dureza", "Belleza", "Carisma", "Ingenio"]
    
    # Dibujar nombres de estadísticas
    stat_names.each_with_index do |name, i|
      angle = angles[i] * Math::PI / 180
      x = base_center_x + (base_radius * 1.4 * Math.cos(angle)).to_i + 24
      y = base_center_y - (base_radius * 1.4 * Math.sin(angle)).to_i + 4
      
      case i
      when 0; x -= 24      ; y -= 16 + 4     #Bellez
      when 4; x += 8 - 32  ; y -= 24      #dulz
      when 1; x -= 24      ; y -= 24      #caris
      when 3; x += 8 - 32  ; y -= 4     #dur
      when 2; x -= 8 + 16  ; y -= 4    #ingen
      end
      
      textpos << [name, x, y, 2, base_color, shadow_color]
    end
    
    # Dibujar valores de estadísticas
    contest_stats.each_with_index do |value, i|
      angle = angles[i] * Math::PI / 180
      x = base_center_x + (base_radius * 1.4 * Math.cos(angle)).to_i + 24
      y = base_center_y - (base_radius * 1.4 * Math.sin(angle)).to_i + 16 + 6
      
      case i
      when 0; x -= 24      ; y -= 16 + 4     #Bellez
      when 4; x += 8 - 32  ; y -= 24      #dulz
      when 1; x -= 24      ; y -= 24      #caris
      when 3; x += 8 - 32  ; y -= 40      #dur
      when 2; x -= 8 + 16  ; y -= 40    #ingen
      end
      
      textpos << [value.to_s, x, y, 2, stat_color, stat_shadow]
    end
    
    textpos << [_INTL("Brillo: {1}", @pokemon.sheen), 66, 296-8, 0, stat_color, stat_shadow]
    pbSetSmallFont(overlay)
    pbDrawTextPositions(overlay, textpos)
    pbSetSystemFont(overlay)
  end
  
  # Método que realmente dibuja un pentágono relleno
  def draw_filled_pentagon_with_values(bitmap, center_x, center_y, radius, values)
    return if values.length != 5
    
    # Colores
    fill_color   = Color.new(72, 204, 240, 191)   # Azul semitransparente
    border_color = Color.new(255, 255, 255, 255)    # Borde blanco
    guide_color  = Color.new(255, 255, 255, 128)  # Guías grises
    outer_color  = Color.new(255, 255, 255, 65)   # Pentágono exterior
    
    # Ángulos para pentágono (empezando desde arriba, sentido horario)
    angles = [90, 18, -54, -126, 162]
    
    # 1. Calcular puntos del pentágono exterior (máximo = 30)
    outer_points = []
    5.times do |i|
      angle = angles[i] * Math::PI / 180
      x = center_x + (radius * Math.cos(angle)).to_i
      y = center_y - (radius * Math.sin(angle)).to_i
      outer_points << [x, y]
    end
    
    # 2. Calcular puntos del pentágono interior según valores
    inner_points = []
    5.times do |i|
      value = values[i]
      current_radius = (radius * value / 255.0).to_i
      angle = angles[i] * Math::PI / 180
      x = center_x + (current_radius * Math.cos(angle)).to_i
      y = center_y - (current_radius * Math.sin(angle)).to_i
      inner_points << [x, y]
    end
    
    # 3. Dibujar pentágono exterior (solo contorno)
    (0...5).each do |i|
      next_i = (i + 1) % 5
      x1, y1 = outer_points[i]
      x2, y2 = outer_points[next_i]
      bitmap.draw_line(x1, y1, x2, y2, outer_color)
    end
    
    # 4. Dibujar líneas guía desde centro a vértices exteriores
    outer_points.each do |x, y|
      bitmap.draw_line(center_x, center_y, x, y, guide_color)
    end
    
    # 5. Dibujar pentágono interior RELLENO (¡esto es lo importante!)
    if inner_points.all? { |x, y| x && y }
      # Primero rellenar el pentágono usando scanline fill
      fill_pentagon_scanline(bitmap, inner_points, fill_color)
      
      # Luego dibujar el borde sobre el relleno
      (0...5).each do |i|
        next_i = (i + 1) % 5
        x1, y1 = inner_points[i]
        x2, y2 = inner_points[next_i]
        bitmap.draw_line(x1, y1, x2, y2, border_color)
      end
      
      # Opcional: conectar al centro para mejor visualización
      inner_points.each do |x, y|
        bitmap.draw_line(center_x, center_y, x, y, fill_color)
      end
    end
    
    # 6. Dibujar un punto en el centro
    draw_filled_circle(bitmap, center_x, center_y, 2, border_color)
  end
  
  # Método para rellenar un pentágono usando algoritmo scanline
  def fill_pentagon_scanline(bitmap, points, color)
    return if points.length != 5
    
    # Encontrar límites Y
    min_y = points.map { |p| p[1] }.min
    max_y = points.map { |p| p[1] }.max
    
    # Para cada línea horizontal (scanline)
    (min_y..max_y).each do |y|
      # Encontrar intersecciones con cada arista
      intersections = []
      
      (0...5).each do |i|
        next_i = (i + 1) % 5
        x1, y1 = points[i]
        x2, y2 = points[next_i]
        
        # Evitar líneas horizontales
        next if y1 == y2
        
        # Verificar si y está entre y1 y y2
        if (y1 <= y && y < y2) || (y2 <= y && y < y1)
          # Calcular intersección x
          intersect_x = x1 + (y - y1) * (x2 - x1).to_f / (y2 - y1).to_f
          intersections << intersect_x.to_i
        end
      end
      
      # Ordenar intersecciones
      intersections.sort!
      
      # Rellenar entre pares de intersecciones
      (0...intersections.length).step(2) do |i|
        break if i + 1 >= intersections.length
        
        x_start = intersections[i]
        x_end = intersections[i + 1]
        
        # Dibujar línea horizontal entre intersecciones
        (x_start..x_end).each do |x|
          # Verificar que esté dentro de los límites del bitmap
          if x >= 0 && x < bitmap.width && y >= 0 && y < bitmap.height
            bitmap.set_pixel(x, y, color)
          end
        end
      end
    end
  end
  
  # Método auxiliar para dibujar círculo relleno (simple)
  def draw_filled_circle(bitmap, center_x, center_y, radius, color)
    (-radius..radius).each do |x|
      (-radius..radius).each do |y|
        if x*x + y*y <= radius*radius
          px = center_x + x
          py = center_y + y
          if px >= 0 && px < bitmap.width && py >= 0 && py < bitmap.height
            bitmap.set_pixel(px, py, color)
          end
        end
      end
    end
  end

# ---------------------------------------------------------------------------
  # Convertir tipo de concurso a número
  # ---------------------------------------------------------------------------
  def pbContestTypeToNumber(typename)
    case typename
    when "Cool"   then return 0
    when "Beauty" then return 1
    when "Cute"   then return 2
    when "Smart"  then return 3
    when "Tough"  then return 4
    else;              return 0
    end
  end
  
