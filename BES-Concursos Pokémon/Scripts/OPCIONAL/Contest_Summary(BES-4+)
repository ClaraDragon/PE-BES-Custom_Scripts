        _INTL("Ingenio: {1}", pkmn.smart),
        _INTL("Dulzura: {1}", pkmn.cute),
        _INTL("Dureza: {1}", pkmn.tough),
        _INTL("Brillo: {1}", pkmn.sheen),
        _INTL("Reiniciar todo a 0"),
        _INTL("Maximizar todo (255)")
      ], cmd)
      
      break if cmd == -1
      
      case cmd
      when 0..4 # Belleza, Fuerza, Astucia, Dulzura, Dureza (0-255)
        stat_names = [
          _INTL("Belleza"),
          _INTL("Carisma"), 
          _INTL("Ingenio"),
          _INTL("Dulzura"),
          _INTL("Dureza")
        ]
        
        current_value = case cmd
        when 0; pkmn.beauty
        when 1; pkmn.cool
        when 2; pkmn.smart
        when 3; pkmn.cute
        when 4; pkmn.tough
        end
        
        params = ChooseNumberParams.new
        params.setRange(0, 255)
        params.setDefaultValue(current_value)
        new_value = Kernel.pbMessageChooseNumber(
          _INTL("Establecer {1} del Pokémon (0-255).", stat_names[cmd]), params) { screen.scene.update }
        
        case cmd
        when 0; pkmn.beauty = new_value
        when 1; pkmn.cool = new_value
        when 2; pkmn.smart = new_value
        when 3; pkmn.cute = new_value
        when 4; pkmn.tough = new_value
        end
        
        screen.pbDisplay(_INTL("{1} de {2} establecido en {3}.", stat_names[cmd], pkmn.name, new_value))
        screen.pbDebugRefresh(pkmnid_or_selected)
        
      when 5 # Brillo (0-255)
        params = ChooseNumberParams.new
        params.setRange(0, 255)
        params.setDefaultValue(pkmn.sheen)
        new_sheen = Kernel.pbMessageChooseNumber(
          _INTL("Establecer Brillo del Pokémon (0-255)."), params) { screen.scene.update }
        
        if new_sheen != pkmn.sheen
          pkmn.sheen = new_sheen
          screen.pbDisplay(_INTL("Brillo de {1} establecido en {2}.", pkmn.name, pkmn.sheen))
          screen.pbDebugRefresh(pkmnid_or_selected)
        end
        
      when 6 # Reiniciar todo a 0
        if Kernel.pbConfirmMessage(_INTL("¿Reiniciar todas las estadísticas de concurso a 0?"))
          pkmn.beauty = 0
          pkmn.cool = 0
          pkmn.smart = 0
          pkmn.cute = 0
          pkmn.tough = 0
          pkmn.sheen = 0
          screen.pbDisplay(_INTL("Todas las estadísticas de concurso de {1} reiniciadas a 0.", pkmn.name))
          screen.pbDebugRefresh(pkmnid_or_selected)
        end
        
      when 7 # Maximizar todo (255)
        if Kernel.pbConfirmMessage(_INTL("¿Maximizar todas las estadísticas de concurso a 255?"))
          pkmn.beauty = 255
          pkmn.cool = 255
          pkmn.smart = 255
          pkmn.cute = 255
          pkmn.tough = 255
          # El brillo normalmente no se maximiza, pero lo ponemos a un valor alto
          pkmn.sheen = 255
          screen.pbDisplay(_INTL("Estadísticas de concurso de {1} maximizadas a 255.", pkmn.name))
          screen.pbDebugRefresh(pkmnid_or_selected)
        end
      end
    end
    next false
  }
})