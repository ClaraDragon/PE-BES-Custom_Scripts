  # ---------------------------------------------------------------------------
  # Modificar drawPage para incluir la nueva página
  # ---------------------------------------------------------------------------
  def drawPage(page)
    if @pokemon.egg?
      drawPageOneEgg
      return
    end
    @sprites["itemicon"].item = @pokemon.item
    overlay = @sprites["overlay"].bitmap
    overlay.clear
    
    if pbResolveBitmap("Graphics/Pictures/Summary/summary#{page}")
      @sprites["background"].setBitmap("Graphics/Pictures/Summary/summary#{page}")
    else
      @sprites["background"].setBitmap("Graphics/Pictures/Summary/summary2")
    end
    
    drawPageIcon(page-1)
    drawCommonElements(page, false)
    if page == 5
      @sprites["pentagon_contest"].visible = true
    else
      @sprites["pentagon_contest"].visible = false 
    end
    
    case page
    when 1; drawPageInfo
    when 2; drawPageData
    when 3; drawPageStats
    when 4; drawPageMoves
    when 5; drawPageContestMoves  # NUEVA PÁGINA
    else;   drawPageRibbons
    end
  end
  
