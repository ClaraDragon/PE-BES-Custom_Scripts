    end
    
    return result
  end
  
  # ---------------------------------------------------------------------------
  # Modificar pbUpdate para incluir nueva lógica
  # ---------------------------------------------------------------------------
  alias contest_pbUpdate pbUpdate
  def pbUpdate
    contest_pbUpdate
    
    # Actualizar sprites de corazones si existen
    if @sprites["contest_hearts"] && !@sprites["contest_hearts"].disposed?
      @sprites["contest_hearts"].update
    end
    if @sprites["contest_jam"] && !@sprites["contest_jam"].disposed?
      @sprites["contest_jam"].update
    end
  end
  
