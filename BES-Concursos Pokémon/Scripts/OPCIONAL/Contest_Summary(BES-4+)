  # ---------------------------------------------------------------------------
  # Crear sprites de corazones (sistema del script de concursos)
  # ---------------------------------------------------------------------------
  def pbCreateSimpleHeartSprite(x, y, count, type, viewport)
    return nil if count <= 0
    
    # Determinar imagen según el tipo
    case type
    when 0  # Corazones normales (exhibición)
      image_name = "Graphics/Pictures/Contest/heart"
      sprite_width = 16
      sprite_height = 16
    when 1  # Corazones negativos (inhibición/jam)
      image_name = "Graphics/Pictures/Contest/negaheart"
      sprite_width = 16
      sprite_height = 16
    else
      return nil
    end
    
    # Configuración
    max_per_row = 8
    rows = ((count - 1) / max_per_row) + 1
    cols = [count, max_per_row].min
    width = cols * sprite_width
    height = rows * sprite_height
    
    # Crear sprite
    sprite = Sprite.new(viewport)
    sprite.bitmap = Bitmap.new(width, height)
    sprite.x = x
    sprite.y = y
    sprite.z = 100003
    
    # Dibujar corazones
    begin
      heart_bitmap = Bitmap.new(image_name)
      for i in 0...count
        row = i / max_per_row
        col = i % max_per_row
        dest_x = col * sprite_width
        dest_y = row * sprite_height
        
        src_rect = Rect.new(0, 0, sprite_width, sprite_height)
        sprite.bitmap.blt(dest_x, dest_y, heart_bitmap, src_rect)
      end
      heart_bitmap.dispose
    rescue
      # Si no existe la imagen, usar texto simple
      sprite.bitmap.dispose
      sprite.bitmap = Bitmap.new(100, 20)
      pbSetSystemFont(sprite.bitmap)
      text = type == 0 ? "♥×#{count}" : "♠×#{count}"
      color = type == 0 ? Color.new(248,72,72) : Color.new(64,64,64)
      sprite.bitmap.font.color = color
      sprite.bitmap.draw_text(0, 0, 100, 20, text)
    end
    
    return sprite
  end
  
